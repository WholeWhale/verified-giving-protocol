---
import Office from '../layouts/Office.astro';
---
<Office
  title="Validate a VGP declaration"
  description="Check a giving.json against VGP 0.1: schema conformance, the authorization invariant, transport, and the Content-Type it is actually served with."
  current="validate"
>

<section class="band band--tight" style="border-top:0">
  <div class="plate">
    <span class="band__no">Plate 01 &middot; validate</span>

    <div class="masthead-split">
      <div>
        <h1 style="max-width:15ch;text-wrap:balance">Check a declaration.</h1>
        <p class="lede" style="margin-top:1.25rem">
          Paste a document, or give a live URL and we will fetch it and report what
          it is actually served as. A declaration served as
          <span class="mono">text/html</span> is a real failure, and it is the one a
          parked domain produces.
        </p>
      </div>
      <aside class="stamp" aria-label="Validator notes">
        <dl>
          <dt>Checks</dt><dd>structure, invariant</dd>
          <dt>Also</dt><dd>transport, media type</dd>
          <dt>Canonical</dt><dd>validate_vgp.py</dd>
          <dt>Network</dt><dd>only for URL mode</dd>
        </dl>
      </aside>
    </div>
  </div>
</section>

<section class="band">
  <div class="plate">
    <div class="val">
      <div>
        <div class="tabs" role="tablist">
          <button class="tab" role="tab" aria-selected="true" data-mode="url">By URL</button>
          <button class="tab" role="tab" aria-selected="false" data-mode="paste">Paste a document</button>
        </div>

        <div id="pane-url" class="pane">
          <label class="vlabel">Declaration URL
            <input id="url" type="url" spellcheck="false" autocomplete="off"
                   placeholder="https://example.org/.well-known/giving.json" />
            <small>Fetched server-side, because a browser cannot read another domain's headers.</small>
          </label>
          <button type="button" class="action" id="run-url">Fetch and check</button>
        </div>

        <div id="pane-paste" class="pane" hidden>
          <label class="vlabel">Document
            <textarea id="paste" rows="16" spellcheck="false" placeholder='{"vgp_version": "0.1", ... }'></textarea>
          </label>
          <button type="button" class="action" id="run-paste">Check</button>
        </div>

        <p class="caption">
          <span class="mono">skill/scripts/validate_vgp.py</span> in the repository is
          canonical and runs offline with no dependencies. This page reports the same
          invariants so you can check a live site without a toolchain.
        </p>
      </div>

      <aside id="report" class="report">
        <p class="fs__note">No document checked yet.</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .val { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: calc(var(--u) * 10); align-items: start; }
  @media (max-width: 1020px) { .val { grid-template-columns: minmax(0, 1fr); } }
  .tabs { display: flex; border-bottom: 2px solid var(--ink); margin-bottom: calc(var(--u) * 5); }
  .tab {
    background: none; border: 0; border-bottom: 3px solid transparent; margin-bottom: -2px;
    font-family: var(--font-mono); font-size: 13px; color: var(--ink-60);
    padding: calc(var(--u) * 2) calc(var(--u) * 4); cursor: pointer;
  }
  .tab[aria-selected='true'] { color: var(--ink); border-bottom-color: var(--ink); font-weight: 600; }
  .vlabel { display: block; font-family: var(--font-mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-60); margin-bottom: calc(var(--u) * 4); }
  .vlabel input, .vlabel textarea {
    display: block; width: 100%; margin-top: calc(var(--u) * 1.5);
    font-family: var(--font-mono); font-size: 14px; text-transform: none; letter-spacing: 0;
    color: var(--ink); background: var(--stock); border: 2px solid var(--ink); border-radius: 0;
    padding: calc(var(--u) * 2.5); resize: vertical;
  }
  .vlabel small { display: block; margin-top: 6px; font-family: var(--font-office); font-size: 11.5px; text-transform: none; letter-spacing: 0; color: var(--ink-60); }
  .report { border: 2px solid var(--ink); background: var(--stock); padding: calc(var(--u) * 5); min-height: 220px; }
  .report h3 { margin-top: 0; }
  .checkline { display: flex; gap: calc(var(--u) * 3); padding: calc(var(--u) * 2) 0; border-bottom: 1px solid var(--ink-35); font-size: 14px; align-items: baseline; }
  .checkline:last-child { border-bottom: 0; }
  .checkline .k { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-60); min-width: 8.5em; }
  .flag { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; padding: 1px 6px; }
  .flag--pass { background: var(--ink); color: var(--board); }
  .flag--fail { border: 1px dashed var(--ink); color: var(--ink); }
  .problems { margin: calc(var(--u) * 4) 0 0; padding-left: 1.2em; font-size: 14px; }
  .problems li { margin-bottom: 5px; }
</style>

<script>
import { problems } from '../lib/vgp.js';

const $ = (s) => document.querySelector(s);
const report = $('#report');

const esc = (s) => String(s).replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));

function line(k, v, state) {
  const flag = state === undefined ? '' :
    `<span class="flag flag--${state ? 'pass' : 'fail'}">${state ? 'pass' : 'check'}</span>`;
  return `<div class="checkline"><span class="k">${k}</span><span>${esc(v)}</span>${flag}</div>`;
}

function render({ transport, doc, parseError }) {
  let html = '';

  if (transport) {
    const t = transport;
    const jsonish = /application\/(schema\+)?json/i.test(t.contentType || '');
    html += '<h3>Transport</h3>';
    html += line('Status', t.status ?? '—', t.ok);
    html += line('Media type', t.contentType || 'none sent', jsonish);
    if (t.redirected) html += line('Redirected to', t.finalUrl);
    if (!jsonish && t.contentType) {
      html += `<p class="fs__note" style="margin-top:calc(var(--u)*3)">Served as <span class="mono">${esc(t.contentType)}</span>. A VGP declaration must be <span class="mono">application/json</span>. A page returning HTTP 200 with HTML on every path is what a parked domain does, and an agent should not treat it as a declaration.</p>`;
    }
  }

  if (parseError) {
    html += '<h3>Document</h3>' + line('JSON', parseError, false);
    report.innerHTML = html;
    return;
  }

  if (doc) {
    const p = problems(doc);
    const approved = doc?.verification?.organization_approved === true;
    const n = Array.isArray(doc?.giving?.authorized_destinations) ? doc.giving.authorized_destinations.length : 0;

    html += '<h3>Declaration</h3>';
    html += line('VGP version', doc?.vgp_version ?? 'missing', doc?.vgp_version === '0.1');
    html += line('Domain', doc?.canonical_domain ?? 'missing');
    html += line('Legal name', doc?.organization?.legal_name ?? 'unresolved');
    html += line('Display name', doc?.organization?.display_name ?? 'unresolved');
    html += line('Approved', approved ? 'yes' : 'no — draft');
    html += line('Authorized', `${n} destination${n === 1 ? '' : 's'}`);

    if (p.length) {
      html += `<h3>Not valid</h3><ul class="problems">${p.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>`;
    } else if (!approved) {
      html += '<h3>Valid unapproved draft</h3><p class="fs__note">Structurally correct, and it authorises nothing. A conforming agent exposes no giving tools for this document, which is the intended behaviour rather than a failure.</p>';
    } else {
      html += '<h3>Valid approved declaration</h3><p class="fs__note">Every listed destination carries the exact affirmation and an approver role. This says the organisation declared these destinations, and nothing beyond that.</p>';
    }
  }

  report.innerHTML = html || '<p class="fs__note">Nothing to report.</p>';
}

function checkText(text, transport) {
  let doc = null, parseError = null;
  try { doc = JSON.parse(text); } catch (e) { parseError = e.message; }
  render({ transport, doc, parseError });
}

document.querySelectorAll('.tab').forEach((tab) => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.tab').forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
    $('#pane-url').hidden = tab.dataset.mode !== 'url';
    $('#pane-paste').hidden = tab.dataset.mode !== 'paste';
  });
});

$('#run-paste').addEventListener('click', () => checkText($('#paste').value, null));

$('#run-url').addEventListener('click', async () => {
  const url = $('#url').value.trim();
  if (!url) return;
  report.innerHTML = '<p class="fs__note">Fetching…</p>';
  try {
    const r = await fetch(`/api/fetch?url=${encodeURIComponent(url)}`);
    const d = await r.json();
    if (d.error) { report.innerHTML = `<h3>Could not fetch</h3>${line('Reason', d.error, false)}`; return; }
    checkText(d.body, d);
  } catch (e) {
    report.innerHTML = `<h3>Could not fetch</h3>${line('Reason', e.message, false)}`;
  }
});
</script>

</Office>
