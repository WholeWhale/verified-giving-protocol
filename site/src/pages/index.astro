---
import Office from '../layouts/Office.astro';

const methods = [
  { no: '01', id: 'credit_card', label: 'credit_card', note: 'online' },
  { no: '02', id: 'ach',         label: 'ach',         note: 'online' },
  { no: '03', id: 'check',       label: 'check',       note: 'offline' },
  { no: '04', id: 'daf',         label: 'daf',         note: 'advised' },
  { no: '05', id: 'stock',       label: 'stock',       note: 'transfer' },
  { no: '06', id: 'crypto',      label: 'crypto',      note: 'online' },
  { no: '07', id: 'workplace',   label: 'workplace',   note: 'matched' },
  { no: '08', id: 'other',       label: 'other',       note: 'declared' },
];
---
<Office
  title="Verified Giving Protocol — declare where donations are authorised to go"
  description="An open standard letting a nonprofit publish, from its own domain, a machine-readable declaration of the giving destinations it authorises. Consumed by AI agents through W3C WebMCP."
  current="home"
>

<!-- ============ PLATE 1 · THE FILE ============ -->
<section class="band band--tight" style="border-top:0">
  <div class="plate">
    <span class="band__no">Plate 01 &middot; the declaration</span>

    <div class="masthead-split">
      <div>
        <h1 style="max-width:16ch;text-wrap:balance">The nonprofit says where its money may go.</h1>

        <p class="lede" style="margin-top:1.25rem">
          An AI agent asked to donate routes to whatever it can parse, and today that is
          structurally never the nonprofit. VGP is one file, published from the one domain
          the organisation controls, declaring the giving destinations it authorises.
        </p>
      </div>

      <aside class="stamp" aria-label="Plate registration">
        <dl>
          <dt>Version</dt><dd>0.1 &middot; draft</dd>
          <dt>Location</dt><dd>/.well-known/giving.json</dd>
          <dt>Media type</dt><dd>application/json</dd>
          <dt>Consumed by</dt><dd>W3C WebMCP</dd>
          <dt>Licence</dt><dd>MIT</dd>
          <dt>Adopters</dt><dd>0 &mdash; none yet</dd>
        </dl>
        <div class="stamp__inks" aria-hidden="true">
          <span class="stamp__ink" style="background:var(--ink)"></span>
          <span class="stamp__ink" style="background:var(--ink-active)"></span>
          <span class="stamp__ink" style="background:var(--ink-mark)"></span>
          <span class="unit-no" style="margin-left:auto;align-self:center">permitted inks &middot; 3</span>
        </div>
      </aside>
    </div>

    <div style="display:grid;grid-template-columns:minmax(0,1.55fr) minmax(0,1fr);gap:2px;background:var(--ink-35);border:2px solid var(--ink);margin-top:2.5rem" class="hero-grid">

      <!-- the file, printed -->
      <div class="file" style="border:0">
        <div class="file__head">
          <svg class="mark" viewBox="0 0 26 26" aria-hidden="true" style="width:16px;height:16px">
            <rect x="1" y="1" width="24" height="24" /><circle class="fill" cx="13" cy="13" r="3.2" />
          </svg>
          <span class="file__path">powerpoetry.org/.well-known/giving.json</span>
          <span class="file__badge">application/json</span>
        </div>
        <pre><code><span class="t-punc">&#123;</span>
  <span class="t-key">"vgp_version"</span><span class="t-punc">:</span> <span class="t-str">"0.1"</span><span class="t-punc">,</span>
  <span class="t-key">"canonical_domain"</span><span class="t-punc">:</span> <span class="t-str">"example.org"</span><span class="t-punc">,</span>
  <span class="t-key">"organization"</span><span class="t-punc">: &#123;</span>
    <span class="t-key">"legal_name"</span><span class="t-punc">:</span> <span class="t-str">"Example Foundation"</span><span class="t-punc">,</span>
    <span class="t-key">"ein"</span><span class="t-punc">:</span> <span class="t-str">"12-3456789"</span><span class="t-punc">,</span>
    <span class="t-key">"country"</span><span class="t-punc">:</span> <span class="t-str">"US"</span>
  <span class="t-punc">&#125;,</span>
  <span class="t-key">"giving"</span><span class="t-punc">: &#123;</span>
    <span class="t-key">"authorized_destinations"</span><span class="t-punc">: [&#123;</span>
      <span class="t-key">"id"</span><span class="t-punc">:</span> <span class="t-str">"direct-card"</span><span class="t-punc">,</span>
      <span class="t-key">"type"</span><span class="t-punc">:</span> <span class="t-str">"credit_card"</span><span class="t-punc">,</span>
      <span class="t-key">"recipient"</span><span class="t-punc">:</span> <span class="t-str">"Example Foundation"</span><span class="t-punc">,</span>
      <span class="t-key">"authorization"</span><span class="t-punc">: &#123;</span>
        <span class="t-key">"status"</span><span class="t-punc">:</span> <span class="t-mark">"authorized"</span><span class="t-punc">,</span>
        <span class="t-key">"approved_by_role"</span><span class="t-punc">:</span> <span class="t-str">"Executive Director"</span><span class="t-punc">,</span>
        <span class="t-key">"approved_at"</span><span class="t-punc">:</span> <span class="t-str">"2026-08-26T00:00:00Z"</span><span class="t-punc">,</span>
        <span class="t-key">"statement"</span><span class="t-punc">:</span> <span class="t-str">"Our organization authorizes
          donations through this destination."</span>
      <span class="t-punc">&#125;</span>
    <span class="t-punc">&#125;]</span>
  <span class="t-punc">&#125;,</span>
  <span class="t-key">"verification"</span><span class="t-punc">: &#123;</span>
    <span class="t-key">"organization_approved"</span><span class="t-punc">:</span> <span class="t-bool">true</span>
  <span class="t-punc">&#125;</span>
<span class="t-punc">&#125;</span></code></pre>
      </div>

      <!-- the two states, side by side -->
      <div style="display:grid;grid-template-rows:1fr 1fr;gap:2px;background:var(--ink-35)">
        <div class="cell" style="justify-content:center">
          <span class="unit-no">01</span>
          <span class="authorised">Authorized</span>
          <p style="margin:0;font-size:14px;max-width:30ch">
            The organisation declared this destination. A human at the nonprofit
            affirmed it, verbatim, and that affirmation is stored in the file.
          </p>
        </div>
        <div class="cell cell--unlisted">
          <span class="not-authorised">Not listed</span>
          <span class="cell__label">
            No declaration exists for this destination. That is a void in the run,
            not a finding about anyone.
          </span>
        </div>
      </div>
    </div>

    <p class="caption">
      Figure 01 &middot; an approved declaration and the two states a consumer may report.
      Ink 3 marks authorisation and appears nowhere else in this system.
    </p>

    <div style="display:flex;gap:calc(var(--u)*3);flex-wrap:wrap;margin-top:2.5rem">
      <a class="action" href="/generate/">Generate a declaration</a>
      <a class="action action--ghost" href="/spec/0.1/">Read the specification</a>
    </div>
  </div>
</section>

<!-- ============ PLATE 2 · THE DISTINCTION ============ -->
<section class="band">
  <div class="plate">
    <span class="band__no">Plate 02 &middot; three statements, routinely conflated</span>
    <h2 style="margin-top:0">Only one of these authorises anything.</h2>

    <div class="table-scroll" style="margin-top:2rem"><table class="register">
      <caption>Specification section 3. The whole protocol is this table.</caption>
      <thead>
        <tr><th>No.</th><th>Statement</th><th>Who makes it</th><th>Means</th><th>Authorises</th></tr>
      </thead>
      <tbody>
        <tr>
          <td class="num">01</td>
          <td><strong class="mono">benefits</strong></td>
          <td>Anyone</td>
          <td>Proceeds from this go to Organization X.</td>
          <td><span class="not-authorised">No</span></td>
        </tr>
        <tr>
          <td class="num">02</td>
          <td><strong class="mono">confirmed</strong></td>
          <td>A discovery process</td>
          <td>Public evidence consistently identifies this destination.</td>
          <td><span class="not-authorised">No</span></td>
        </tr>
        <tr>
          <td class="num">03</td>
          <td><strong class="mono">authorized</strong></td>
          <td>The organisation</td>
          <td>We declare this an approved giving destination.</td>
          <td><span class="authorised">Yes</span></td>
        </tr>
      </tbody>
    </table></div>

    <p style="margin-top:2rem">
      No volume, quality, or agreement of evidence converts <span class="mono">confirmed</span>
      into <span class="mono">authorized</span>. Discovery may propose; only a human at the
      nonprofit may publish. The affirmation is compared as a constant, not a sentiment —
      a paraphrase is refused by the tooling.
    </p>
  </div>
</section>

<!-- ============ PLATE 3 · THE KIOSK ============ -->
<section class="band">
  <div class="plate">
    <span class="band__no">Plate 03 &middot; permitted methods</span>
    <h2 style="margin-top:0">Eight declared methods. Nothing else prints.</h2>
    <p style="margin-bottom:2rem">
      Every destination carries a numbered method, a named recipient, and an
      authorisation record. Each unit is cited by the same number in the
      specification, the generator, and the validator.
    </p>

    <div class="kiosk">
      {methods.map((m) => (
        <div class="cell" data-interactive tabindex="0">
          <div class="cell__head">
            <span class="unit-no">{m.no}</span>
            <span class="cell__meta">{m.note}</span>
          </div>
          <span class="cell__label">{m.label}</span>
        </div>
      ))}
      <div class="cell cell--unlisted">
        <span class="cell__label">any method not declared prints as an empty box</span>
      </div>
    </div>
    <p class="caption">
      Figure 03 &middot; the permitted method set. A ninth cell cannot be added by a
      consumer, a processor, or an agent.
    </p>
  </div>
</section>

<!-- ============ PLATE 4 · ADOPTION ============ -->
<section class="band">
  <div class="plate">
    <span class="band__no">Plate 04 &middot; adoption</span>
    <h2 style="margin-top:0">An afternoon, in four operations.</h2>

    <div class="table-scroll" style="margin-top:2rem"><table class="register">
      <thead><tr><th>No.</th><th>Operation</th><th>Where it happens</th><th>Who does it</th></tr></thead>
      <tbody>
        <tr><td class="num">01</td><td>Draft the declaration</td><td class="mono">/generate</td><td>Developer</td></tr>
        <tr><td class="num">02</td><td>Authorise each destination</td><td>Off the machine</td><td><strong>The nonprofit</strong></td></tr>
        <tr><td class="num">03</td><td>Serve it</td><td class="mono">/.well-known/giving.json</td><td>Developer</td></tr>
        <tr><td class="num">04</td><td>Register the agent tools</td><td class="mono">giving-tools.js</td><td>Developer</td></tr>
      </tbody>
    </table></div>

    <p style="margin-top:2rem">
      Operation 02 is not automatable and has no tooling. A nonprofit administrator
      affirms, verbatim: <em>&ldquo;Our organization authorizes donations through this
      destination.&rdquo;</em> Everything else on this site exists to make the other
      three operations short.
    </p>

    <div style="display:flex;gap:calc(var(--u)*3);flex-wrap:wrap;margin-top:2rem">
      <a class="action" href="/generate/">Start operation 01</a>
      <a class="action action--ghost" href="/validate/">Check an existing file</a>
    </div>
  </div>
</section>

<style>
  .masthead-split {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 0.9fr);
    gap: calc(var(--u) * 12);
    align-items: start;
  }
  @media (max-width: 900px) {
    /* minmax(0,1fr), never 1fr: a grid item defaults to min-width:auto and
       refuses to shrink below the JSON block, which drags the page wider
       than the viewport. */
    .hero-grid { grid-template-columns: minmax(0, 1fr) !important; }
    .masthead-split { grid-template-columns: minmax(0, 1fr); gap: calc(var(--u) * 8); }
  }
</style>

<script>
  // Signature interaction: the register and the file are one object.
  // Focusing a method cell shifts it off-register and marks its line in the file.
  const cells = document.querySelectorAll<HTMLElement>('.cell[data-interactive]');
  cells.forEach((cell) => {
    const label = cell.querySelector('.cell__label')?.textContent?.trim();
    if (!label) return;
    const mark = () => {
      document.querySelectorAll<HTMLElement>('.file .t-str').forEach((t) => {
        if (t.textContent?.replace(/"/g, '').trim() === label) t.classList.add('cell--active');
      });
    };
    cell.addEventListener('mouseenter', mark);
    cell.addEventListener('focus', mark);
  });
</script>

</Office>
