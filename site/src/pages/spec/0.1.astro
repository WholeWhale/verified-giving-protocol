---
import { readFileSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { marked } from 'marked';
import Office from '../../layouts/Office.astro';

// Read the specification from the repository root at build time. One source:
// the site renders the same bytes the standard ships, so a published page
// cannot drift from the document it claims to be.
const specPath = fileURLToPath(new URL('../../../../vgp/specification.md', import.meta.url));
const raw = readFileSync(specPath, 'utf-8');

// Strip the H1 — the page supplies its own masthead — and collect the section
// headings for the contents plate.
const body = raw.replace(/^#\s+.*\n/, '');
const sections = [...body.matchAll(/^##\s+(\d+)\.\s+(.+)$/gm)].map(([, n, title]) => ({
  n,
  title,
  id: `section-${n}`,
}));

marked.use({
  gfm: true,
  renderer: {
    heading({ tokens, depth }) {
      const text = this.parser.parseInline(tokens);
      const m = /^(\d+)\.\s+(.*)$/.exec(text);
      if (depth === 2 && m) {
        return `<h2 id="section-${m[1]}"><span class="unit-no">${m[1]}</span> ${m[2]}</h2>\n`;
      }
      return `<h${depth}>${text}</h${depth}>\n`;
    },
  },
});

const html = marked.parse(body);
---
<Office
  title="Verified Giving Protocol 0.1 — specification"
  description="The VGP 0.1 specification. Section 3 defines the authorization semantics that separate benefits and confirmed from authorized."
  current="spec"
>

<section class="band band--tight" style="border-top:0">
  <div class="plate">
    <span class="band__no">Specification &middot; version 0.1 &middot; draft</span>

    <div class="spec-layout" style="margin-top:calc(var(--u)*6)">
      <div>
        <h1 style="max-width:18ch;text-wrap:balance">Verified Giving Protocol 0.1</h1>
        <p class="lede" style="margin-top:1.25rem">
          Section 3 is the protocol. Everything else is encoding.
        </p>

        <div class="prose" set:html={html} />
      </div>

      <aside class="spec-aside">
        <div class="contents">
          <span class="unit-no" style="display:block;margin-bottom:calc(var(--u)*3)">Contents</span>
          <ol>
            {sections.map((s) => (
              <li>
                <a href={`#${s.id}`}><span class="n">{s.n}</span><span>{s.title}</span></a>
              </li>
            ))}
          </ol>
        </div>

        <div class="stamp" style="margin-top:calc(var(--u)*5)">
          <dl>
            <dt>Version</dt><dd>0.1 &middot; draft</dd>
            <dt>Status</dt><dd>no standards body</dd>
            <dt>Schema</dt><dd><a href="/schema/vgp-0.1.schema.json">schema.json</a></dd>
            <dt>Licence</dt><dd>MIT</dd>
          </dl>
        </div>

        <p class="caption" style="margin-top:calc(var(--u)*5)">
          Rendered at build time from <span class="mono">vgp/specification.md</span> in the
          repository. There is no second copy of this text.
        </p>
      </aside>
    </div>
  </div>
</section>

</Office>
