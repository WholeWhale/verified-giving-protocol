{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedgiving.org/schema/vgp-0.1.schema.json",
  "title": "Verified Giving Protocol 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vgp_version",
    "canonical_domain",
    "organization",
    "giving",
    "verification"
  ],
  "properties": {
    "vgp_version": {
      "const": "0.1"
    },
    "canonical_domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?!-)[A-Za-z0-9.-]+(?<!-)$"
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_name",
        "display_name",
        "ein",
        "country"
      ],
      "properties": {
        "legal_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "ein": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{2}-[0-9]{7}$"
        },
        "country": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{2}$"
        }
      }
    },
    "giving": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorized_destinations",
        "designations"
      ],
      "properties": {
        "authorized_destinations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/destination"
          }
        },
        "designations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/designation"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organization_approved",
        "published_at",
        "updated_at"
      ],
      "properties": {
        "organization_approved": {
          "type": "boolean"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "organization_approved": {
                "const": false
              }
            },
            "required": [
              "organization_approved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "giving": {
            "properties": {
              "authorized_destinations": {
                "maxItems": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "giving": {
            "properties": {
              "authorized_destinations": {
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "organization_approved": {
                "const": true
              }
            },
            "required": [
              "organization_approved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "organization": {
            "properties": {
              "legal_name": {
                "type": "string",
                "minLength": 1
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "country": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": {
              "organization_approved": {
                "const": true
              }
            },
            "required": [
              "organization_approved"
            ]
          },
          "organization": {
            "properties": {
              "country": {
                "const": "US"
              }
            },
            "required": [
              "country"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "organization": {
            "properties": {
              "ein": {
                "type": "string",
                "pattern": "^[0-9]{2}-[0-9]{7}$"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "provider",
        "url",
        "recipient",
        "recurring",
        "designation_support",
        "restrictions",
        "authorization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "credit_card",
            "ach",
            "check",
            "daf",
            "stock",
            "crypto",
            "workplace",
            "other"
          ]
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "recipient": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code the destination charges in. Required for online methods: an amount without a currency is not an amount, and a consumer MUST NOT infer one from the organization's country."
        },
        "recurring": {
          "type": "boolean"
        },
        "designation_support": {
          "type": "boolean"
        },
        "restrictions": {
          "type": [
            "string",
            "null"
          ]
        },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "approved_by_role",
            "approved_at",
            "statement"
          ],
          "properties": {
            "status": {
              "const": "authorized"
            },
            "approved_by_role": {
              "type": "string",
              "minLength": 2
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "statement": {
              "const": "Our organization authorizes donations through this destination."
            }
          }
        },
        "prefill": {
          "type": [
            "object",
            "null"
          ],
          "description": "Optional. How to construct a URL that arrives at this destination with fields already filled. Declared by the organization, never inferred by a consumer.",
          "additionalProperties": false,
          "required": [
            "url_template",
            "parameters",
            "verified_at"
          ],
          "properties": {
            "url_template": {
              "type": "string",
              "description": "Absolute HTTPS URL containing {name} placeholders for declared parameters. Placeholders for parameters a consumer does not supply MUST be removed along with their query key."
            },
            "parameters": {
              "type": "object",
              "description": "The only fields a consumer may fill. A field absent here MUST be left to the human.",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "amount",
                      "enum",
                      "text"
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Required when kind is enum. The platform's exact vocabulary; a consumer MUST NOT send a value outside it."
                  },
                  "min": {
                    "type": "number",
                    "description": "Optional. Smallest value the platform will accept for this parameter."
                  },
                  "max": {
                    "type": "number",
                    "description": "Optional. Largest value the platform will accept. A consumer MUST omit the parameter rather than send a value outside these bounds, because a platform that silently ignores an out-of-range value leaves the donor on a default the agent never chose."
                  }
                }
              }
            },
            "verified_at": {
              "type": "string",
              "description": "Date the template was last checked against the live platform. A consumer MAY decline to use a stale template."
            }
          }
        }
      }
    },
    "designation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
