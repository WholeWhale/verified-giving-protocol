{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verifiedgiving.org/schema/vgp-0.1.schema.json",
  "title": "Verified Giving Protocol 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vgp_version", "canonical_domain", "organization", "giving", "verification"],
  "properties": {
    "vgp_version": { "const": "0.1" },
    "canonical_domain": {
      "type": "string",
      "pattern": "^(?=.{1,253}$)(?!-)[A-Za-z0-9.-]+(?<!-)$"
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "display_name", "ein", "country"],
      "properties": {
        "legal_name": { "type": ["string", "null"] },
        "display_name": { "type": ["string", "null"] },
        "ein": { "type": ["string", "null"], "pattern": "^[0-9]{2}-[0-9]{7}$" },
        "country": { "type": ["string", "null"], "pattern": "^[A-Z]{2}$" }
      }
    },
    "giving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized_destinations", "designations"],
      "properties": {
        "authorized_destinations": {
          "type": "array",
          "items": { "$ref": "#/$defs/destination" }
        },
        "designations": {
          "type": "array",
          "items": { "$ref": "#/$defs/designation" }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization_approved", "published_at", "updated_at"],
      "properties": {
        "organization_approved": { "type": "boolean" },
        "published_at": { "type": ["string", "null"], "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "organization_approved": { "const": false } },
            "required": ["organization_approved"]
          }
        }
      },
      "then": {
        "properties": {
          "giving": {
            "properties": { "authorized_destinations": { "maxItems": 0 } }
          }
        }
      },
      "else": {
        "properties": {
          "giving": {
            "properties": { "authorized_destinations": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "organization_approved": { "const": true } },
            "required": ["organization_approved"]
          }
        }
      },
      "then": {
        "properties": {
          "organization": {
            "properties": {
              "legal_name": { "type": "string", "minLength": 1 },
              "display_name": { "type": "string", "minLength": 1 },
              "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification": {
            "properties": { "organization_approved": { "const": true } },
            "required": ["organization_approved"]
          },
          "organization": {
            "properties": { "country": { "const": "US" } },
            "required": ["country"]
          }
        }
      },
      "then": {
        "properties": {
          "organization": {
            "properties": {
              "ein": { "type": "string", "pattern": "^[0-9]{2}-[0-9]{7}$" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "provider", "url", "recipient", "recurring", "designation_support", "restrictions", "authorization"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "type": { "enum": ["credit_card", "ach", "check", "daf", "stock", "crypto", "workplace", "other"] },
        "provider": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"], "format": "uri" },
        "recipient": { "type": "string", "minLength": 1 },
        "recurring": { "type": "boolean" },
        "designation_support": { "type": "boolean" },
        "restrictions": { "type": ["string", "null"] },
        "authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "approved_by_role", "approved_at", "statement"],
          "properties": {
            "status": { "const": "authorized" },
            "approved_by_role": { "type": "string", "minLength": 2 },
            "approved_at": { "type": "string", "format": "date-time" },
            "statement": { "const": "Our organization authorizes donations through this destination." }
          }
        }
      }
    },
    "designation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] }
      }
    }
  }
}
